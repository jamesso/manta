{
  "name": "Manta",
  "homepage": "https://manta.life",
  "productName": "Manta",
  "version": "1.1.4",
  "license": "GPL-3.0",
  "description": "Flexible invoicing desktop app with beautiful & customizable templates",
  "author": {
    "name": "Hung Q. Le",
    "email": "lequochung@me.com"
  },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && node -e \"require('fs').cpSync('static','out/main/static',{recursive:true})\" && playwright test",
    "test:watch": "vitest",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder -mwl",
    "release:linux": "yarn run build && yarn run dist:linux",
    "release:win": "yarn run build && yarn run dist:win",
    "release:mac": "yarn run build && yarn run dist:mac",
    "release": "yarn run build && yarn run dist",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@hello-pangea/dnd": "^18.0.1",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "events": "^3.3.0",
    "i18next": "^26.5.12",
    "is-svg": "^3.0.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "motion": "^14.9.0",
    "pouchdb-browser": "^9.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-redux": "^9.3.1",
    "redux": "^5.0.1",
    "redux-actions": "^3.0.3",
    "reselect": "^5.3.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "enzyme": {
      "cheerio": "1.0.0-rc.12"
    }
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "ejs@2.7.4": true,
    "fsevents@2.3.3": true,
    "styled-components@3.4.10": true
  }
}
