{
  "name": "Manta",
  "homepage": "https://github.com/jamesso/manta",
  "repository": "github:jamesso/manta",
  "bugs": "https://github.com/jamesso/manta/issues",
  "productName": "Manta",
  "version": "1.1.4",
  "license": "GPL-3.0",
  "description": "Flexible invoicing desktop app with beautiful & customizable templates",
  "author": {
    "name": "Hung Q. Le",
    "email": "lequochung@me.com"
  },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:watch": "vitest",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder -mwl",
    "release:linux": "npm run build && npm run dist:linux",
    "release:win": "npm run build && npm run dist:win",
    "release:mac": "npm run build && npm run dist:mac",
    "release": "npm run build && npm run dist",
    "lint": "oxlint .",
    "format": "oxfmt --write \"**/*.{js,jsx,mjs}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,mjs}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@e-invoice-eu/core": "3.4.4",
    "@emotion/is-prop-valid": "^1.4.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "events": "^3.3.0",
    "i18next": "^27.1.5",
    "is-svg": "^6.1.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.74.0",
    "moment": "^2.31.0",
    "pouchdb-browser": "^9.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-is": "^19.3.1",
    "react-redux": "^9.3.1",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "redux-actions": "^3.0.3",
    "reselect": "^5.3.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fake-indexeddb": "^6.2.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
